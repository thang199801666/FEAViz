@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
@FVIZ_QT_PACKAGE_DEPENDENCY@

include("${CMAKE_CURRENT_LIST_DIR}/FEAVizTargets.cmake")

set(FEAViz_Core_FOUND FALSE)
set(FEAViz_FEA_FOUND FALSE)
if(TARGET FEAViz::Core)
    set(FEAViz_Core_FOUND TRUE)
endif()
if(TARGET FEAViz::FEA)
    set(FEAViz_FEA_FOUND TRUE)
endif()

# Source-compatibility target retained for pre-0.40 consumers.  New generic
# applications should link FEAViz::Core; FEA post-processing applications link
# FEAViz::FEA (which transitively links Core).
if(NOT TARGET FEAViz::FEAViz)
    add_library(FEAViz::FEAViz INTERFACE IMPORTED GLOBAL)
    if(TARGET FEAViz::FEA)
        set_property(TARGET FEAViz::FEAViz PROPERTY INTERFACE_LINK_LIBRARIES FEAViz::FEA)
    elseif(TARGET FEAViz::Core)
        set_property(TARGET FEAViz::FEAViz PROPERTY INTERFACE_LINK_LIBRARIES FEAViz::Core)
    endif()
endif()

check_required_components(FEAViz)
